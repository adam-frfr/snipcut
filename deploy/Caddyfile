# Caddy reverse proxy for Snipcut — automatic HTTPS from Let's Encrypt.
# Replace clips.example.com with your domain (its DNS A record must point
# at the VPS), copy this to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
clips.example.com {
	# Landing-page uploads send the whole file in one request (up to 2 GB);
	# dashboard uploads send 2 MB chunks. Allow both.
	request_body {
		max_size 2200MB
	}

	reverse_proxy 127.0.0.1:3000 {
		# Long-running work happens in background jobs, but a 2 GB upload on
		# a slow connection still needs a generous write timeout.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}
