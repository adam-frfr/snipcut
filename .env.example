# Snipcut configuration. Copy to .env (Docker / VPS) or .env.local (npm run dev).
# Keys can also be entered per-user in the app's Keys/Settings dialog.

# REQUIRED in production: the passcode users type to unlock the app.
# Without it every API call is refused (the server fails closed).
# Generate one with:  openssl rand -base64 24
APP_ACCESS_TOKEN=

# Transcription — at least one of these. Groq is fast and has a free tier.
GROQ_API_KEY=
OPENAI_API_KEY=

# Clip selection — Anthropic Claude (or the Groq/OpenAI key above).
ANTHROPIC_API_KEY=

# Optional: stock B-roll for the "B-roll" effect
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: YouTube downloads from a datacenter IP are often bot-checked.
# Save cookies from a signed-in browser in the app (Settings → YouTube
# Cookies), or put them here; a residential proxy also helps.
YOUTUBE_COOKIES=
YOUTUBE_PROXY=
