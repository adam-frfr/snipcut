# Snipcut configuration. Copy to .env (Docker / VPS) or .env.local (npm run dev).
# Keys can also be entered per-user in the app's Keys/Settings dialog.

# REQUIRED in production: the passcode users type to unlock the app.
# Without it every API call is refused (the server fails closed).
# Generate one with:  openssl rand -base64 24
APP_ACCESS_TOKEN=

# Transcription — at least one of these. Groq is fast and has a free tier.
GROQ_API_KEY=
OPENAI_API_KEY=

# Clip selection — Anthropic Claude (or the Groq/OpenAI key above).
ANTHROPIC_API_KEY=

# B-roll sources, in order: Pexels / Pixabay stock (only if you already have
# a key — both paused new keys), then AI-generated images from
# OPENAI_API_KEY (gpt-image-1, a few cents per cutaway). With none of them,
# clips get no B-roll. BROLL_ALLOW_WIKIMEDIA=1 enables a no-key image
# fallback, but its pictures are often off-topic.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Unsplash Access Key (photos only) — the Access Key, not the Secret key
UNSPLASH_ACCESS_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
BROLL_ALLOW_WIKIMEDIA=0

# Optional: YouTube downloads from a datacenter IP are often bot-checked.
# Save cookies from a signed-in browser in the app (Settings → YouTube
# Cookies), or put them here; a residential proxy also helps.
YOUTUBE_COOKIES=
YOUTUBE_PROXY=

# Clips rendered automatically per video (default 6 = all of them).
MAX_CLIPS_TO_RENDER=6
# Hours uploads, downloads, rendered clips (+ thumbnails) and B-roll are kept.
# Cleanup runs when the server starts and every hour.
FILE_RETENTION_HOURS=24

# Optional built-in HTTPS: your domain (its DNS A record must point at this
# server), then start with:  docker compose --profile https up -d --build
DOMAIN=
